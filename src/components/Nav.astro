---
import { LOGO, BUSINESS } from '../data/content.js';
---

<header id="nav" class="fixed inset-x-0 top-3 z-50 px-3 sm:px-5">
  <nav
    class="relative mx-auto flex max-w-[1240px] items-center justify-between gap-4 rounded-full border-2 border-ink/10 bg-cream/95 px-4 py-2.5 shadow-[0_8px_0_rgba(27,22,48,0.07)] backdrop-blur transition-all duration-300 sm:px-6"
    aria-label="Primary"
  >
    <ul class="hidden items-center gap-6 lg:flex">
      <li><a class="navlink" href="#home">Home</a></li>
      <li><a class="navlink" href="#zones">Zones</a></li>
      <li><a class="navlink" href="#about">About</a></li>
    </ul>

    <a
      href="#home"
      class="group absolute left-1/2 flex -translate-x-1/2 items-center gap-2.5 lg:static lg:translate-x-0"
    >
      <img
        src={LOGO}
        alt={`${BUSINESS.name} logo`}
        width="48"
        height="48"
        class="h-11 w-11 rounded-full border-2 border-ink object-cover transition-transform duration-300 group-hover:rotate-5 sm:h-12 sm:w-12"
      />
      <span class="hidden font-display text-lg uppercase leading-none tracking-tight text-ink sm:block lg:hidden xl:block">
        Sound<span class="text-gold">.</span>
      </span>
    </a>

    <div class="flex items-center gap-3">
      <ul class="hidden items-center gap-5 lg:flex">
        <li><a class="navlink" href="#visit">Visit</a></li>
        <li>
          <details class="relative">
            <summary class="navlink flex cursor-pointer list-none items-center gap-1">
              More
              <svg width="10" height="7" viewBox="0 0 10 7" aria-hidden="true" class="mt-px">
                <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
              </svg>
            </summary>
            <div
              class="absolute right-0 top-full mt-3 w-48 rounded-3xl border-2 border-ink bg-cream p-2 shadow-[6px_6px_0_var(--ink)]"
            >
              <a class="dropdownlink" href="#experience">Experience</a>
              <a class="dropdownlink" href="#craft">The Craft</a>
              <a class="dropdownlink" href="#reviews">Reviews</a>
              <a class="dropdownlink" href="#feed">Instagram</a>
            </div>
          </details>
        </li>
      </ul>

      <a href={BUSINESS.tel} class="icon-chip hidden sm:grid" aria-label={`Call ${BUSINESS.phone}`}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.4 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.4 1.8.6 2.8.8a2 2 0 0 1 1.7 2Z" />
        </svg>
      </a>

      <button
        id="menuBtn"
        class="icon-chip lg:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobileMenu"
      >
        <svg width="18" height="14" viewBox="0 0 18 14" aria-hidden="true">
          <path d="M0 1h18M0 7h18M0 13h18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </nav>
</header>

<div
  id="mobileMenu"
  class="fixed inset-0 z-[60] hidden flex-col bg-ink px-6 py-6 text-cream lg:hidden"
>
  <div class="flex items-center justify-between">
    <img src={LOGO} alt="" width="44" height="44" class="h-11 w-11 rounded-full border-2 border-cream object-cover" />
    <button id="menuClose" class="icon-chip bg-cream text-ink" aria-label="Close menu">
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M1 1l14 14M15 1L1 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>
  </div>
  <ul class="mt-12 flex flex-col gap-6">
    <li><a class="moblink" href="#home">Home</a></li>
    <li><a class="moblink" href="#about">About</a></li>
    <li><a class="moblink" href="#zones">Zones</a></li>
    <li><a class="moblink" href="#experience">Experience</a></li>
    <li><a class="moblink" href="#craft">The Craft</a></li>
    <li><a class="moblink" href="#reviews">Reviews</a></li>
    <li><a class="moblink" href="#visit">Visit</a></li>
  </ul>
  <div class="mt-auto flex flex-wrap gap-3">
    <a class="btn" href={BUSINESS.tel}>
      Call {BUSINESS.phone}
      <span class="btn-chip" aria-hidden="true">↗</span>
    </a>
    <a class="btn btn--dark" href={BUSINESS.instagram} target="_blank" rel="noopener">
      Instagram
      <span class="btn-chip btn-chip--pink" aria-hidden="true">↗</span>
    </a>
  </div>
</div>