---
import Checker from './Checker.astro';
import Card from './Card.astro';
import { ZONES } from '../data/content.js';
---

<section id="zones" class="relative bg-ink pt-24 text-cream md:pt-32">
  <div class="mx-auto max-w-shell px-5">
    <div class="grid items-end gap-8 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="eyebrow text-cream/60">SIGNATURE ZONES</p>
        <h2 class="reveal-h mt-4 text-gold">
          A room for every<br />kind of player.
        </h2>
      </div>
      <div class="flex items-end justify-between gap-6 lg:col-span-5">
        <p class="max-w-xs text-[15px] leading-relaxed text-cream/75">
          Four ways to spend an evening under one roof. Pick your seat — the rest is already set
          up for you.
        </p>
        <Checker
          type="cluster"
          cols={5}
          rows={5}
          a="bg-lav"
          b="bg-gold"
          hidden={['0-4', '2-0', '4-4']}
          class="w-24 shrink-0"
        />
      </div>
    </div>

    <div
      class="carousel reveal"
      data-carousel
      role="listbox"
      aria-label="Sound Cyber Cafe zones"
      aria-activedescendant="zone-1"
    >
      {ZONES.map((z, i) => <Card zone={z} index={i} active={i === 1} />)}
    </div>

    <div class="mt-10 flex items-center justify-center gap-4 pb-16">
      <button class="round-btn" data-prev aria-label="Previous zone">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>
      </button>
      <p class="mono text-xs uppercase tracking-[0.25em] text-cream/60">
        <span data-index>02</span> / 04
      </p>
      <button class="round-btn" data-next aria-label="Next zone">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </button>
    </div>
  </div>

  <Checker type="strip" colorA="var(--ink)" colorB="var(--cream)" size="46px" class="checker-on-seam" />
</section>