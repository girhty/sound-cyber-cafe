---
import Checker from './Checker.astro';
import { STEPS } from '../data/content.js';
---

<section id="craft" class="bg-butter py-24 md:py-32">
  <div class="mx-auto max-w-shell px-5">
    <div class="grid items-end gap-8 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="eyebrow text-ink/60">THE CRAFT</p>
        <h2 class="mt-4 text-ink">Simple setup.<br />Careful hands.</h2>
      </div>
      <div class="flex items-end justify-between gap-6 lg:col-span-5">
        <p class="max-w-xs text-[15px] leading-relaxed text-ink/75">
          Everything is kept ready before you arrive — the rigs, the rooms, the tables. You just
          turn up and play.
        </p>
        <Checker type="cluster" cols={5} rows={4} a="bg-gold" b="bg-lav" class="w-20 shrink-0" hidden={['0-0', '3-4']} />
      </div>
    </div>

    <div class="craft-card reveal" data-craft>
      <div class="craft-stage">
        <div class="craft-copy">
          <span class="craft-badge" data-badge>01</span>
          <p class="eyebrow mt-5 text-gold" data-label>SELECT</p>
          <h3 class="mt-3 text-cream" data-title>Pick your rig</h3>
          <p class="mt-4 max-w-sm text-[15px] leading-relaxed text-cream/75" data-text>
            {STEPS[0].text}
          </p>
        </div>
        <div class="craft-pic">
          <span class="craft-pic-shadow" aria-hidden="true"></span>
          <img
            src={STEPS[0].img}
            alt={STEPS[0].alt}
            width="900"
            height="700"
            loading="lazy"
            data-img
          />
        </div>
      </div>

      <div class="craft-tabs" role="tablist" aria-label="How a session works">
        {STEPS.map((s, i) => (
          <button
            class:list={['craft-tab', { 'is-on': i === 0 }]}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            data-tab={i}
          >
            <span class="craft-tab-title">{s.title}</span>
            <span class="craft-tab-num">0{i + 1}</span>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>