---
import { BUSINESS, POSTS } from '../data/content.js';
const grid = POSTS.slice(0, 6);
---

<section id="feed" class="bg-butter py-24 md:py-32">
  <div class="mx-auto max-w-shell px-5">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="eyebrow text-ink/60">INSTAGRAM</p>
        <h2 class="mt-4 text-ink">Straight from<br />the feed.</h2>
      </div>

      <div class="flex flex-wrap items-center gap-4">
        <div class="flex items-center gap-3 rounded-full border-2 border-ink bg-cream px-4 py-2">
          <img
            src={BUSINESS.instagram && undefined}
            alt=""
            width="0"
            height="0"
            class="hidden"
          />
          <span class="mono text-sm font-bold">@sound.iraq</span>
        </div>
        <div class="rounded-full border-2 border-ink bg-lav px-4 py-2">
          <span class="mono text-sm font-bold">5,015 followers</span>
        </div>
        <a class="btn" href={BUSINESS.instagram} target="_blank" rel="noopener">
          Follow
          <span class="btn-chip" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8" /></svg>
          </span>
        </a>
      </div>
    </div>

    <ul class="ig-grid reveal">
      {grid.map((p) => (
        <li>
          <a class="ig-card" href={BUSINESS.instagram} target="_blank" rel="noopener">
            <img src={p.img} alt={p.alt} width="640" height="640" loading="lazy" />
            <span class="ig-overlay">
              <span class="mono flex items-center gap-2 text-sm font-bold">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21s-7.5-4.6-9.5-9A5.4 5.4 0 0 1 12 6.6 5.4 5.4 0 0 1 21.5 12c-2 4.4-9.5 9-9.5 9Z" /></svg>
                {p.likes}
              </span>
              <span class="ig-caption">{p.caption}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>