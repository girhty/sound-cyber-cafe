---
import { GALLERY } from '../data/content.js';
---

<section id="experience" class="bg-cream py-24 md:py-32">
  <div class="mx-auto grid max-w-shell items-start gap-12 px-5 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <p class="eyebrow text-ink/55">THE EXPERIENCE</p>
      <h2 class="mt-4 text-ink">
        Come for one match.<br />Stay all night.
      </h2>
      <p class="mt-5 max-w-md text-[15px] leading-relaxed text-ink/75">
        Big screens for the big games, quiet corners for the long ones. Bring your squad, keep
        the table, order another round.
      </p>
      <div class="mt-7">
        <a class="btn" href="#visit">
          Plan your visit
          <span class="btn-chip" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </span>
        </a>
      </div>
      <ul class="chip-row mt-8">
        <li class="tag">PS5 ROOMS</li>
        <li class="tag">MATCH NIGHTS</li>
        <li class="tag">BILLIARD TOURNAMENTS</li>
        <li class="tag">COFFEE &amp; DRINKS</li>
      </ul>
    </div>

    <div class="lg:col-span-7">
      <div class="gallery reveal" data-gallery>
        <div class="gallery-main">
          {GALLERY.map((g, i) => (
            <img
              src={g.img}
              alt={g.alt}
              width="1200"
              height="900"
              loading={i === 0 ? 'eager' : 'lazy'}
              class:list={[{ 'is-on': i === 0 }]}
              data-slide={i}
            />
          ))}
          <span class="gallery-count mono"><b data-gcount>01</b> / 0{GALLERY.length}</span>
        </div>

        <div class="thumbs" role="tablist" aria-label="Photo gallery">
          {GALLERY.map((g, i) => (
            <button
              class:list={['thumb', { 'is-on': i === 0 }]}
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-label={`Show photo ${i + 1}`}
              data-thumb={i}
            >
              <img src={g.img} alt="" width="240" height="240" loading="lazy" />
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>